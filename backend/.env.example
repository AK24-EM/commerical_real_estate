# Database Configuration (Supabase) - Add your credentials here
DATABASE_URL=postgresql://postgres:your_password@your-project.supabase.co:5432/postgres

# Meilisearch Configuration (Local)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=magicbricksMasterKey123

# Redis Configuration (Upstash) - Add your credentials here
REDIS_URL=redis://default:your_password@your-upstash-redis-url.upstash.io:6379

# Google Maps API (Optional - for footfall calculations)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_URL=https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY_HERE&callback=console.debug&libraries=maps,marker&v=beta

# Server Configuration
PORT=3000
NODE_ENV=development

# Razorpay Configuration (for subscription payments)
# Get your credentials from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Note: Use test credentials (rzp_test_*) for development
# Use live credentials (rzp_live_*) for production
